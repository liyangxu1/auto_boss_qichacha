# 复制为 .env 后填写。main.py 自动读取；analyze 命令需传入 --env-file .env。
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash-1017
# 填模型服务的完整基础路径，不要附加 /responses 或 /chat/completions。
OPENAI_BASE_URL=https://api.tokenpony.cn/v1
# 支持 responses 或 chat-completions。
OPENAI_API_FORMAT=chat-completions
# 兼容接口使用 JSON 对象模式，字段结构仍在本地校验。
OPENAI_JSON_MODE=true
# 接口连接和读取的等待限制，单位为秒。
OPENAI_TIMEOUT=300
# 仅模型服务直连，不修改系统代理、Codex或BOSS网络。
OPENAI_DIRECT=false
# 以下选项用于TokenPony兼容接口；其他服务不支持时留空或关闭。
OPENAI_STREAM=true
OPENAI_ENABLE_THINKING=false
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_TEMPERATURE=0
